# Supabase — jwellert shop
NEXT_PUBLIC_SUPABASE_URL=https://ktvzsfydpnnkqydkfuhq.supabase.co

# API keys from Dashboard → Settings → API Keys
# Use either the new format (recommended) OR legacy JWT keys — not both required.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Legacy JWT keys (optional — only if you have not migrated to sb_* keys yet)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# App URL (use your live Netlify URL in production)
NEXT_PUBLIC_APP_URL=https://jwelleryshophsp.netlify.app

# Admin — comma-separated emails allowed to access /admin
ADMIN_EMAILS=your@gmail.com

# Shopping assistant — free tier recommended (Google AI Studio / Groq)
# Without any key, basic keyword rules still work.
# GEMINI_API_KEY=          # https://aistudio.google.com/apikey (SHE Collection bot)
# GOOGLE_GENERATIVE_AI_API_KEY=  # alias for GEMINI_API_KEY
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_API_KEY=            # https://console.groq.com (free tier)
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENAI_API_KEY=sk-...
# SHOP_ASSISTANT_MODEL=gpt-4o-mini

# Optional — payments & email
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# JAZZCASH_WEBHOOK_SECRET=generate-a-long-random-string
# EASYPAISA_WEBHOOK_SECRET=generate-a-long-random-string
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=orders@yourdomain.com
